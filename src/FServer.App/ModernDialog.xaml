<Window x:Class="FServer.App.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="460"
        MinHeight="120"
        MaxHeight="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BodyBackgroundGradient}"
        WindowStyle="SingleBorderWindow"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Border Margin="16"
            Background="{DynamicResource ControlBackground}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20,14,20,14">

        <StackPanel>
            <!-- 标题栏 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Viewbox x:Name="IconBlock"
                         Width="28"
                         Height="28"
                         Stretch="Fill"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText"
                           Margin="10,0,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource HeadingForeground}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 正文：纯 TextBlock，Wrap + LineHeight 决定行数 → 完全自适应 -->
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       Foreground="{DynamicResource TextForeground}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,2,0,12"/>

            <!-- 按钮行（靠右） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSecondary"
                        Width="84" Height="30"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Click="BtnSecondary_Click"/>
                <Button x:Name="BtnPrimary"
                        Width="84" Height="30"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnPrimary_Click"/>
                <Button x:Name="BtnTertiary"
                        Width="84" Height="30"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Click="BtnTertiary_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
