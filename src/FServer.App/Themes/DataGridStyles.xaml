<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====== 表格专用画刷（复用 LightTheme 主色体系）====== -->
    <LinearGradientBrush x:Key="DataGridHeaderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0F9FF" Offset="0"/>
        <GradientStop Color="#E0F2FE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DataGridHeaderBottomBorder" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="DataGridRowSeparator" Color="#E5F3FB"/>

    <!-- ====== DataGrid 全局样式（最小可靠：只改属性，不替换 Template）====== -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="False"/>
        <!-- IsReadOnly 交给 DataGrid 自身声明（用户管理页要可编辑）-->
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DataGridRowSeparator}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ====== 列头样式 ====== -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{StaticResource DataGridHeaderGradient}"/>
        <Setter Property="Foreground" Value="{DynamicResource CardHeadingForeground}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource DataGridHeaderBottomBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- ====== 行样式：极简 Template 只做一件事——让内容垂直居中 ====== -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <!-- 只包 CellsPresenter + 强制垂直居中 + 零边距 -->
                    <Grid Background="{TemplateBinding Background}">
                        <DataGridCellsPresenter VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Margin="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#E0F2FE"/>
                <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====== 单元格样式（关键：Cell Template 里 ContentPresenter 垂直居中）====== -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="CellBorder"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <!-- 显式给 ContentPresenter VerticalAlignment=Center，让 TextBlock/TextBox 内容垂直居中 -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CellBorder" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="CellBorder" Property="Background" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== 显式 ModernCheckBox 样式（带 x:Key，供 DataTemplateColumn 直接引用）====== -->
    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="CheckBorder"
                            Width="16" Height="16"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ToggleOffBackground}"
                            BorderThickness="1"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Path x:Name="CheckMark"
                              Width="8" Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 1 4 L 3 6 L 7 2"
                              Stroke="{DynamicResource ToggleThumbBackground}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Fill"
                              Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background"
                                    Value="{DynamicResource ToggleOnBackground}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush"
                                    Value="{DynamicResource ToggleOnBackground}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush"
                                    Value="{DynamicResource ToggleOnBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====== ModernCheckBoxWithLabel：勾选框在前（左），文字在后（右）。供带说明文字的场景 ====== -->
    <Style x:Key="ModernCheckBoxWithLabel" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,0,0,2"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 勾框（前置） -->
                        <Border x:Name="CheckBorder"
                                Grid.Column="0"
                                Width="16" Height="16"
                                Margin="0,0,8,0"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ToggleOffBackground}"
                                BorderThickness="1"
                                CornerRadius="3"
                                SnapsToDevicePixels="True"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckMark"
                                  Width="8" Height="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1 4 L 3 6 L 7 2"
                                  Stroke="{DynamicResource ToggleThumbBackground}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Fill"
                                  Visibility="Collapsed"/>
                        </Border>
                        <!-- 标签文字（后置） -->
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background"
                                    Value="{DynamicResource ToggleOnBackground}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush"
                                    Value="{DynamicResource ToggleOnBackground}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush"
                                    Value="{DynamicResource ToggleOnBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
