<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FServer.App</AssemblyName>
    <RootNamespace>FServer.App</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <!-- 自动触发 cargo build：先判断 cargo 是否存在 + DLL 是否需要重建 -->
  <PropertyGroup>
    <!-- 注意：cargo 默认 target 目录相对于 crate 根 -->
    <FtpCoreDll Condition="'$(FtpCoreDll)' == ''">..\..\rust\ftp_core\target\x86_64-pc-windows-msvc\release\ftp_core.dll</FtpCoreDll>
    <FtpCoreSourceDir>..\..\rust\ftp_core\src</FtpCoreSourceDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(FtpCoreDll)" CopyToOutputDirectory="PreserveNewest" Link="ftp_core.dll" />
  </ItemGroup>

  <Target Name="BuildFtpCore" BeforeTargets="BeforeCompile" Inputs="$(FtpCoreSourceDir)\**\*.rs;..\..\rust\ftp_core\Cargo.toml" Outputs="$(FtpCoreDll)">
    <Message Text="Building Rust ftp_core..." Importance="high" />
    <Exec Command="cargo build --release --target x86_64-pc-windows-msvc" WorkingDirectory="..\..\rust\ftp_core" ConsoleToMsBuild="true" />
    <!-- cargo 默认产物名：ftp_core.dll (因为 crate-type=cdylib, crate-name=ftp_core) -->
    <Exec Command="if NOT EXIST $(FtpCoreDll) echo ERROR: ftp_core.dll not built at $(FtpCoreDll) &amp; exit /b 1" ConsoleToMsBuild="true" />
  </Target>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.25" />
  </ItemGroup>

</Project>
