    <Window x:Class="FServer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FServer.App"
        Title="FServer FTP 管理" Height="640" Width="920"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
        <local:EmptyTextOrList x:Key="EmptyTextOrList"/>
    </Window.Resources>
    <Border Background="{DynamicResource BodyBackgroundGradient}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="FServer FTP 服务"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeadingForeground}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ToggleBtn"
                            Content="{Binding StartStopLabel}"
                            IsEnabled="{Binding ToggleButtonEnabled}"
                            Style="{Binding IsRunning, Converter={StaticResource BoolToToggleBtnStyle}, ConverterParameter=StopButton|PrimaryButton}"
                            Click="Toggle_Click"/>
                </StackPanel>
            </Grid>

            <!-- 主区 -->
            <TabControl Grid.Row="1">
                <!-- Tab 1: 服务配置 -->
                <TabItem Header="服务配置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <GroupBox Header="监听设置" Margin="0,0,0,12">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="端口" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="(默认 2121)"
                                                   Foreground="{DynamicResource TextForeground}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="根目录" Margin="0,0,0,12">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding RootDir, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="浏览..." Click="PickRoot_Click" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="高级" Margin="0,0,0,12">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="最大连接数" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding MaxConnections, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: 用户管理 -->
                <TabItem Header="用户管理">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 新增区 -->
                        <GroupBox Grid.Row="0" Header="新增用户" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewUser.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding NewUser.Password, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                <CheckBox Grid.Column="2" Content="只读" IsChecked="{Binding NewUser.ReadOnly}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="添加" Style="{StaticResource PrimaryButton}"
                                        Click="AddUser_Click"/>
                            </Grid>
                        </GroupBox>

                        <!-- 列表 -->
                        <DataGrid x:Name="UserGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Users}"
                                  CanUserResizeColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="用户名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120">
                                    <!-- guest 行：编辑态 TextBox 禁用（IsEnabled=false），可见但不可改 -->
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="IsEnabled">
                                                <Setter.Value>
                                                    <Binding Path="IsProtected" Converter="{StaticResource BoolInvert}"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <Binding Path="IsProtected" Converter="{StaticResource BoolToProtectedTip}"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="密码" Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="IsEnabled">
                                                <Setter.Value>
                                                    <Binding Path="IsProtected" Converter="{StaticResource BoolInvert}"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <Binding Path="IsProtected" Converter="{StaticResource BoolToProtectedTip}"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="只读" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding ReadOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="启用" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="专属根路径（空=默认）"
                                                    Binding="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="260"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 操作栏 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="删除选中"
                                    Click="RemoveUser_Click"
                                    ToolTip="{Binding SelectedItem.IsProtected, Converter={StaticResource BoolToProtectedTip}}"
                                    IsEnabled="{Binding SelectedItem, Converter={StaticResource ObjectToEnabled}}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Tab 3: 日志 -->
                <TabItem Header="日志">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="LogListBox"
                                 Grid.Row="0"
                                 ItemsSource="{Binding LogLines}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Background="{DynamicResource ControlBackground}"
                                 BorderBrush="{DynamicResource ControlBorderBrush}"
                                 BorderThickness="1">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="2,0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 两行纵向布局：上=时间+级别标签，下=完整消息 -->
                                    <Grid Margin="0,3,0,3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 第 1 行：日期时间 + 级别小徽章（紧凑 16px 高） -->
                                        <StackPanel Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <!-- 日期 -->
                                            <TextBlock Text="{Binding Time, StringFormat=yyyy-MM-dd}"
                                                       Foreground="#94A3B8"
                                                       FontFamily="Consolas"
                                                       FontSize="11"/>
                                            <TextBlock Text=" "
                                                       FontFamily="Consolas"
                                                       FontSize="11"/>
                                            <!-- 时间 -->
                                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                       Foreground="#64748B"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                            <!-- 级别小徽章（左侧带色，White 文字） -->
                                            <Border Margin="8,0,0,0"
                                                    Padding="6,1"
                                                    CornerRadius="3"
                                                    Background="{Binding Level, Converter={StaticResource LogLevelToBrush}}">
                                                <TextBlock Text="{Binding Level}"
                                                           Foreground="White"
                                                           FontFamily="Consolas"
                                                           FontSize="10"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- 第 2 行：完整消息（主文本区域，按级别着色） -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Message}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="WrapWithOverflow"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="清空" Click="ClearLog_Click"/>
                            <TextBlock Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0">
                                <Run Text="{Binding LogLines.Count, Mode=OneWay}"/>
                                <Run Text=" 条日志"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Tab 4: 在线会话 -->
                <TabItem Header="在线会话">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Sessions}"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="200"/>
                                <DataGridTextColumn Header="上线时间" Binding="{Binding OnlineSince, StringFormat=HH:mm:ss}" Width="160"/>
                                <DataGridTextColumn Header="在线时长" Binding="{Binding OnlineFor}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <TextBlock Foreground="{DynamicResource TextForeground}">
                                <Run Text="在线用户数："/>
                                <Run Text="{Binding Sessions.Count, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 状态栏 -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 运行状态灯 -->
                <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,6,0"
                         Fill="{Binding IsRunning, Converter={StaticResource BoolToStatusBrush}}"/>
                <!-- 端口 -->
                <TextBlock Grid.Column="1" Text="{Binding Port, StringFormat=端口: {0}}"
                           Foreground="{DynamicResource TextForeground}"
                           VerticalAlignment="Center"/>
                <!-- 本机 IP + 刷新按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="本机 IP:" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PrimaryIp}"
                               Foreground="{DynamicResource HeadingForeground}"
                               FontWeight="SemiBold"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding LocalIpList, Converter={StaticResource EmptyTextOrList}}"/>
                    <!-- 刷新按钮：点一下重新枚举网卡 -->
                    <Button Content="↻ 刷新"
                            Click="RefreshIp_Click"
                            Margin="6,0,0,0"
                            Padding="8,1"
                            FontSize="11"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 分隔 + 运行态文字 -->
                <TextBlock Grid.Column="4" Text="{Binding IsRunning, Converter={StaticResource BoolToRunText}}"
                           Foreground="{DynamicResource HeadingForeground}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
