    <Window x:Class="FServer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FServer.App"
        Title="FServer" Height="640" Width="920"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="/FServer.Icons;component/ftp.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
        <local:EmptyTextOrList x:Key="EmptyTextOrList"/>
        <local:RatioToWidthConverter x:Key="RatioToWidth"/>
        <local:TransferOpToBrushConverter x:Key="TransferOpToBrush"/>
        <local:BytesDisplayConverter x:Key="BytesDisplay"/>
    </Window.Resources>
    <Border Background="{DynamicResource BodyBackgroundGradient}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="FServer FTP 服务"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeadingForeground}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="关于" Click="AboutBtn_Click" Margin="0,0,8,0" Width="60"/>
                    <Button x:Name="ToggleBtn"
                            Content="{Binding StartStopLabel}"
                            IsEnabled="{Binding ToggleButtonEnabled}"
                            Style="{Binding IsRunning, Converter={StaticResource BoolToToggleBtnStyle}, ConverterParameter=StopButton|PrimaryButton}"
                            Click="Toggle_Click"/>
                </StackPanel>
            </Grid>

            <!-- 主区 -->
            <TabControl Grid.Row="1">
                <!-- Tab 1: 服务配置 -->
                <TabItem Header="服务配置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <GroupBox Header="监听设置" Margin="0,0,0,12">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="端口" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="(默认 2121)"
                                                   Foreground="{DynamicResource TextForeground}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="根目录" Margin="0,0,0,12">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding RootDir, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="浏览..." Click="PickRoot_Click" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="高级" Margin="0,0,0,12">
                                <StackPanel Margin="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="最大连接数" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding MaxConnections, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 启动行为（Release/Debug 都可见） -->
                            <GroupBox Header="启动行为" Margin="0,0,0,12">
                                <StackPanel Margin="10">
                                    <CheckBox Content="静默启动"
                                              IsChecked="{Binding SilentStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernCheckBoxWithLabel}"/>
                                    <TextBlock Foreground="#64748B" FontSize="11" Margin="24,2,0,8">
                                        <Run Text="启动时隐藏主窗口，仅托盘运行，关闭主窗口默认仍会最小化到托盘；勾选此项则直接启动到托盘。"/>
                                    </TextBlock>

                                    <CheckBox Content="开机自启动"
                                              IsChecked="{Binding AutoStartServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernCheckBoxWithLabel}"/>
                                    <TextBlock Foreground="#64748B" FontSize="11" Margin="24,2,0,0">
                                        <Run Text="仅对当前登录用户生效，无需管理员权限；开机后程序将按当前的静默启动行为运行。"/>
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="被动模式端口范围）" Margin="0,0,0,12"
                                      Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="10">
                                    <TextBlock Foreground="#64748B" FontSize="11" Text="企业内网/NAT 环境建议固定一个范围（如 50000-60000），并同步在防火墙开放该段。Start 前生效。"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="最小：" VerticalAlignment="Center" Width="48"/>
                                        <TextBox Text="{Binding PassiveMinPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="80" Height="26" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="  最大：" VerticalAlignment="Center" Margin="10,0,0,0" Width="48"/>
                                        <TextBox Text="{Binding PassiveMaxPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="80" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="登录横幅 / MOTD" Margin="0,0,0,12"
                                      Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="10">
                                    <TextBox Text="{Binding BannerText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             Height="80"
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"/>
                                    <TextBlock Foreground="#64748B" FontSize="11" Margin="0,6,0,0">
                                        FTP 客户端连接时会先收到这条消息，支持多行。修改后重启 FTP 生效。（留空默认 220 Ready）
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: 用户管理 -->
                <TabItem Header="用户管理">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 新增区 -->
                        <GroupBox Grid.Row="0" Header="新增用户" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewUser.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding NewUser.Password, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                                <CheckBox Grid.Column="2" Content="只读" IsChecked="{Binding NewUser.ReadOnly}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="添加" Style="{StaticResource PrimaryButton}"
                                        Click="AddUser_Click"/>
                            </Grid>
                        </GroupBox>

                        <!-- 列表 -->
                        <DataGrid x:Name="UserGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Users}"
                                  CanUserResizeColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="用户名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120">
                                    <!-- guest 行：编辑态 TextBox 禁用（IsEnabled=false），可见但不可改 -->
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="IsEnabled">
                                                <Setter.Value>
                                                    <Binding Path="IsProtected" Converter="{StaticResource BoolInvert}"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <Binding Path="IsProtected" Converter="{StaticResource BoolToProtectedTip}"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="密码" Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="IsEnabled">
                                                <Setter.Value>
                                                    <Binding Path="IsProtected" Converter="{StaticResource BoolInvert}"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <Binding Path="IsProtected" Converter="{StaticResource BoolToProtectedTip}"
                                                             RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="只读" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding ReadOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="启用" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="专属根路径（空=默认）"
                                                    Binding="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="260"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 操作栏 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="删除选中"
                                    Click="RemoveUser_Click"
                                    ToolTip="{Binding SelectedItem.IsProtected, Converter={StaticResource BoolToProtectedTip}}"
                                    IsEnabled="{Binding SelectedItem, Converter={StaticResource ObjectToEnabled}}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Tab 3: 日志（内嵌子 Tab 切换实时/历史） -->
                <TabItem Header="日志">
                    <TabControl Margin="6">
                        <!-- 子 Tab: 实时日志 -->
                        <TabItem Header="实时日志">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox x:Name="LogListBox"
                                         Grid.Row="0"
                                         ItemsSource="{Binding LogLines}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         Background="{DynamicResource ControlBackground}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         BorderThickness="1">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="2,0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 两行纵向布局：上=时间+级别标签，下=完整消息 -->
                                            <Grid Margin="0,3,0,3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- 第 1 行：日期时间 + 级别小徽章（紧凑 16px 高） -->
                                                <StackPanel Grid.Row="0"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <!-- 日期 -->
                                                    <TextBlock Text="{Binding Time, StringFormat=yyyy-MM-dd}"
                                                               Foreground="#94A3B8"
                                                               FontFamily="Consolas"
                                                               FontSize="11"/>
                                                    <TextBlock Text=" "
                                                               FontFamily="Consolas"
                                                               FontSize="11"/>
                                                    <!-- 时间 -->
                                                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                               Foreground="#64748B"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                    <!-- 级别小徽章（左侧带色，White 文字） -->
                                                    <Border Margin="8,0,0,0"
                                                            Padding="6,1"
                                                            CornerRadius="3"
                                                            Background="{Binding Level, Converter={StaticResource LogLevelToBrush}}">
                                                        <TextBlock Text="{Binding Level}"
                                                                   Foreground="White"
                                                                   FontFamily="Consolas"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 第 2 行：完整消息（主文本区域，按级别着色） -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Message}"
                                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="WrapWithOverflow"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="清空" Click="ClearLog_Click"/>
                                    <TextBlock Foreground="#64748B"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0">
                                        <Run Text="{Binding LogLines.Count, Mode=OneWay}"/>
                                        <Run Text=" 条日志"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <!-- 子 Tab: 历史日志 -->
                        <TabItem Header="历史日志">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="📂 打开日志目录" Click="OpenLogFolder_Click" Width="140"/>
                                    <Button Content="🔄 刷新" Click="RefreshHistoryLogs_Click" Width="80" Margin="8,0,0,0"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1"
                                          x:Name="HistoryLogGrid"
                                          ItemsSource="{Binding HistoryLogs}"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeColumns="False"
                                          CanUserSortColumns="False"
                                          CanUserReorderColumns="False"
                                          AutoGenerateColumns="False"
                                          MouseDoubleClick="HistoryLogGrid_DoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="260"/>
                                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/>
                                        <DataGridTextColumn Header="时长" Binding="{Binding Duration}" Width="110"/>
                                        <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- Tab 4: 在线会话 -->
                <TabItem Header="在线会话">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="SessionGrid"
                                  ItemsSource="{Binding Sessions}"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserReorderColumns="False"
                                  AutoGenerateColumns="False">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="强制断开此用户" Click="KickSession_Click"
                                              Foreground="#E53E3E"/>
                                    <Separator/>
                                    <MenuItem Header="刷新列表" Click="RefreshSessions_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="200"/>
                                <DataGridTextColumn Header="上线时间" Binding="{Binding OnlineSince, StringFormat=HH:mm:ss}" Width="160"/>
                                <DataGridTextColumn Header="在线时长" Binding="{Binding OnlineFor}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <TextBlock Foreground="{DynamicResource TextForeground}">
                                <Run Text="在线用户数："/>
                                <Run Text="{Binding Sessions.Count, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Tab: 传输活动（Rust 侧 DataListener 推的 DOWNLOAD/UPLOAD/DELETE/...） -->
                <TabItem Header="传输活动">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="🧹 清空" Click="ClearTransfers_Click" Width="80"/>
                            <TextBlock Foreground="#64748B" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding Transfers.Count, Mode=OneWay}"/>
                                <Run Text=" 条活动（最多保留 500 条）"/>
                            </TextBlock>
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Transfers}"
                                  IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeColumns="False" CanUserSortColumns="False"
                                  CanUserReorderColumns="False" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="80"/>
                                <DataGridTextColumn Header="操作" Binding="{Binding Op}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Op, Converter={StaticResource TransferOpToBrush}}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="用户" Binding="{Binding Username}" Width="140"/>
                                <DataGridTextColumn Header="大小" Binding="{Binding BytesDisplay}" Width="100"/>
                                <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="备注" Binding="{Binding Extra}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab: 统计面板 -->
                <TabItem Header="统计面板">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <!-- 顶部操作 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="🔄 刷新" Click="RefreshDashboard_Click" Width="80"/>
                                <TextBlock Foreground="#64748B" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11">
                                    数据来自 SQLite
                                </TextBlock>
                            </StackPanel>

                            <!-- 今日汇总 -->
                            <GroupBox Header="今日">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                        <TextBlock Foreground="#64748B" FontSize="11">下载总量</TextBlock>
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HeadingForeground}" Margin="0,4,0,0">
                                            <Run Text="{Binding TodayBytesDown, Mode=OneWay, Converter={StaticResource BytesDisplay}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Foreground="#64748B" FontSize="11">上传总量</TextBlock>
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HeadingForeground}" Margin="0,4,0,0">
                                            <Run Text="{Binding TodayBytesUp, Mode=OneWay, Converter={StaticResource BytesDisplay}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Foreground="#64748B" FontSize="11">今日操作数</TextBlock>
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HeadingForeground}" Margin="0,4,0,0">
                                            <Run Text="{Binding TodayTotalOps, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- 7 天汇总 -->
                            <GroupBox Header="近 7 天">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Foreground="#64748B" FontSize="11">下载合计</TextBlock>
                                        <TextBlock FontSize="16" FontWeight="Bold" Margin="0,2,0,0">
                                            <Run Text="{Binding TotalBytesDown7d, Mode=OneWay, Converter={StaticResource BytesDisplay}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="#64748B" FontSize="11">上传合计</TextBlock>
                                        <TextBlock FontSize="16" FontWeight="Bold" Margin="0,2,0,0">
                                            <Run Text="{Binding TotalBytesUp7d, Mode=OneWay, Converter={StaticResource BytesDisplay}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Foreground="#64748B" FontSize="11">操作次数</TextBlock>
                                        <TextBlock FontSize="16" FontWeight="Bold" Margin="0,2,0,0">
                                            <Run Text="{Binding TotalOps7d, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Foreground="#64748B" FontSize="11">单日峰值</TextBlock>
                                        <TextBlock FontSize="16" FontWeight="Bold" Margin="0,2,0,0">
                                            <Run Text="{Binding PeakBytesDay7d, Mode=OneWay, Converter={StaticResource BytesDisplay}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- 近 7 天柱状图 -->
                            <GroupBox Header="近 7 天传输量">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding DashboardBars}" Margin="10,8,10,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <!-- 日期标签 -->
                                                    <TextBlock Text="{Binding Label}" Width="56" VerticalAlignment="Center"
                                                               Foreground="#64748B" FontSize="11" FontFamily="Consolas"/>
                                                    <!-- 条形区：固定宽 300 -->
                                                    <Border Width="300" Height="18" Background="#E2E8F0"
                                                            CornerRadius="3" Margin="6,0,6,0">
                                                        <Rectangle HorizontalAlignment="Left" Height="18"
                                                                   Fill="#3B82F6"
                                                                   Width="{Binding Ratio, Converter={StaticResource RatioToWidth}, ConverterParameter=300}"/>
                                                    </Border>
                                                    <!-- 数值 -->
                                                    <TextBlock Text="{Binding TotalDisplay}" Width="80"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource HeadingForeground}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Foreground="#94A3B8" FontSize="11" Margin="120,0,0,8" Text="条形长度=当天传输量相对 7 天峰值的比例"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- 状态栏 -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 运行状态灯 -->
                <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,6,0"
                         Fill="{Binding IsRunning, Converter={StaticResource BoolToStatusBrush}}"/>
                <!-- 端口 -->
                <TextBlock Grid.Column="1" Text="{Binding Port, StringFormat=端口: {0}}"
                           Foreground="{DynamicResource TextForeground}"
                           VerticalAlignment="Center"/>
                <!-- 本机 IP + 刷新按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="本机 IP:" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PrimaryIp}"
                               Foreground="{DynamicResource HeadingForeground}"
                               FontWeight="SemiBold"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{Binding LocalIpList, Converter={StaticResource EmptyTextOrList}}"/>
                    <!-- 刷新按钮：点一下重新枚举网卡 -->
                    <Button Content="↻ 刷新"
                            Click="RefreshIp_Click"
                            Margin="6,0,0,0"
                            Padding="8,1"
                            FontSize="11"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 分隔 + 运行态文字 -->
                <TextBlock Grid.Column="4" Text="{Binding IsRunning, Converter={StaticResource BoolToRunText}}"
                           Foreground="{DynamicResource HeadingForeground}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
